# Copy to .env.local and fill in your MongoDB Atlas connection string
# Example (replace <user>, <password>, and <cluster> accordingly):
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/flint-crm?retryWrites=true&w=majority"
# A secret token used to protect the /api/seed endpoint. Set this in Vercel as SEED_SECRET.
SEED_SECRET="replace-with-a-random-hex-string"
